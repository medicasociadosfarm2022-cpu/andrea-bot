# ============================================================
#  Configuracion del bot Andrea
#  Copia este archivo como ".env" y rellena tus datos reales.
# ============================================================

# ---- Servidor ----
PORT=3000
# Token opcional para proteger el webhook. Invéntate uno (texto largo)
# y ponlo IGUAL al configurar el webhook en Evolution (lo añades como ?token=...)
WEBHOOK_TOKEN=

# ---- Evolution API (tu instancia en EasyPanel) ----
# URL base de tu Evolution, SIN barra final. Ej: https://evolution.tudominio.com
EVOLUTION_API_URL=https://tu-evolution.easypanel.host
# El apikey global de Evolution (variable AUTHENTICATION_API_KEY de tu instancia)
EVOLUTION_API_KEY=tu_apikey_de_evolution
# El nombre EXACTO de la instancia conectada a WhatsApp
EVOLUTION_INSTANCE=nombre_de_tu_instancia

# ---- OpenAI ----
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# gpt-4o-mini es barato y suficiente. Puedes usar gpt-4o para más calidad.
OPENAI_MODEL=gpt-4o-mini

# ---- Supabase ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Usa la clave "service_role" (Project Settings > API). NO la anon.
SUPABASE_SERVICE_KEY=eyJhbGciOiJ...

# ---- Memoria de conversación ----
# Cuántos mensajes previos recordar por contacto al generar la respuesta.
HISTORY_LIMIT=12
